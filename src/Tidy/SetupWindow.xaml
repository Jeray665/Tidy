<ui:FluentWindow x:Class="Tidy.SetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Instalar Tidy" Width="560" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" Title="Tidy" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{DynamicResource AppLogo}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Margin="32,8,32,28">
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource AppLogo}" Width="56" Height="56" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="Sub" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="Body" Style="{StaticResource Muted}" FontSize="13" LineHeight="21" Margin="0,20,0,0" />

            <StackPanel x:Name="Options" Margin="0,16,0,0">
                <CheckBox x:Name="Desktop" Content="Crear un acceso directo en el escritorio" IsChecked="True" />
                <CheckBox x:Name="Startup" Content="Arrancar con Windows en la bandeja (libera la RAM sola)" IsChecked="True" Margin="0,6,0,0" />
                <CheckBox x:Name="DeleteData" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="Borrar también mis ajustes, el historial y las copias de seguridad (después ya no se podrán deshacer los cambios)" />
                </CheckBox>
            </StackPanel>

            <ui:InfoBar x:Name="Error" Severity="Error" IsClosable="False" Margin="0,16,0,0" />
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Margin="0,18,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button x:Name="Secondary" Click="Secondary_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="Primary" Appearance="Primary" Click="Primary_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
