<Page x:Class="Tidy.Views.SecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Seguridad">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Seguridad" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Revisión de solo lectura: Tidy no cambia nada aquí. Te dice qué está bien, qué conviene revisar y te lleva a la pantalla de Windows donde se arregla." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeroBadge" Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon x:Name="HeroIcon" Symbol="Shield24" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" FontSize="20" FontWeight="SemiBold" Text="Comprobando…" />
                    <TextBlock x:Name="HeroSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" Text="Antivirus, firewall, actualizaciones, arranque seguro, discos…" />
                </StackPanel>
                <ui:Button x:Name="RecheckBtn" Grid.Column="2" Content="Volver a comprobar" Icon="{ui:SymbolIcon ArrowClockwise24}" VerticalAlignment="Center" Click="Recheck_Click" />
            </Grid>
        </Border>

        <StackPanel x:Name="Checks" Margin="0,14,0,0" />
    </StackPanel>
</Page>
