<Page x:Class="Tidy.Views.ImagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Imágenes">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Imágenes" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Convierte, comprime y reduce fotos de golpe. Los originales no se tocan: cada imagen se guarda como una copia nueva." />

        <!-- 1 · which images -->
        <TextBlock Text="1. Elige las imágenes" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FilesInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                               Text="JPG, PNG, HEIC, WebP, AVIF, BMP, TIFF, GIF e ICO." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Añadir imágenes…" Icon="{ui:SymbolIcon ImageAdd24}" Appearance="Primary" Click="AddFiles_Click" />
                        <ui:Button Content="Añadir una carpeta…" Icon="{ui:SymbolIcon FolderAdd24}" Margin="6,0,0,0" Click="AddFolder_Click" />
                        <ui:Button x:Name="ClearBtn" Content="Quitar todas" Margin="6,0,0,0" Click="Clear_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <ListBox x:Name="FileList" Style="{StaticResource RowList}" Height="240" Margin="0,12,0,0" Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Image24" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="18,0,8,0" ToolTip="{Binding Status}" />
                                <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Dismiss16}" Padding="7,5" ToolTip="Quitar de la lista" Tag="{Binding}" Click="Remove_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 2 · what to do -->
        <TextBlock Text="2. Qué hacer con ellas" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Formato" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <ComboBox x:Name="FormatBox" Grid.Column="1" Width="340" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="Options_Changed">
                    <ComboBoxItem Content="El mismo de cada imagen" Tag="" />
                    <ComboBoxItem Content="JPG · fotos, ocupa poco" Tag="jpg" />
                    <ComboBoxItem Content="PNG · sin pérdida, con transparencia" Tag="png" />
                    <ComboBoxItem Content="BMP · sin comprimir" Tag="bmp" />
                    <ComboBoxItem Content="TIFF · sin pérdida, para imprenta" Tag="tiff" />
                    <ComboBoxItem Content="GIF · 256 colores" Tag="gif" />
                    <ComboBoxItem Content="ICO · icono de Windows" Tag="ico" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="Calidad JPG" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,24,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="Quality" Width="300" Minimum="40" Maximum="100" Value="85" TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="Quality_Changed" />
                        <TextBlock x:Name="QualityText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="40" />
                    </StackPanel>
                    <TextBlock x:Name="QualityHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Tamaño" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,24,0" />
                <ComboBox x:Name="SizeBox" Grid.Row="2" Grid.Column="1" Width="340" HorizontalAlignment="Left" Margin="0,14,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="El original" Tag="0" />
                    <ComboBoxItem Content="Como mucho 3840 px (4K)" Tag="3840" />
                    <ComboBoxItem Content="Como mucho 2560 px" Tag="2560" />
                    <ComboBoxItem Content="Como mucho 1920 px (Full HD)" Tag="1920" />
                    <ComboBoxItem Content="Como mucho 1280 px" Tag="1280" />
                    <ComboBoxItem Content="Como mucho 800 px (web y correo)" Tag="800" />
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Privacidad" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,18,24,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                    <CheckBox x:Name="StripBox" IsChecked="True" Content="Quitar los datos ocultos: ubicación GPS, modelo de cámara y fecha" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,0,0,0"
                               Text="Las fotos del móvil guardan dónde se hicieron. Recomendado si las vas a compartir. Al cambiar de formato no se copian nunca." />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Guardar en" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,18,24,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,14,0,0">
                    <RadioButton x:Name="NextTo" GroupName="Dest" IsChecked="True" Content="La misma carpeta que cada original, como &quot;nombre (Tidy).jpg&quot;" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="Elsewhere" GroupName="Dest" Content="Otra carpeta" Checked="Elsewhere_Checked" />
                        <ui:Button x:Name="DestBtn" Content="Elegir…" Margin="10,0,0,0" Click="ChooseDest_Click" />
                        <TextBlock x:Name="DestText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3 · go -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="Status" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="OpenBtn" Content="Abrir carpeta" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0" Click="Open_Click" Visibility="Collapsed" />
                <ui:Button x:Name="CancelBtn" Content="Cancelar" Margin="0,0,8,0" Click="Cancel_Click" Visibility="Collapsed" />
                <ui:Button x:Name="GoBtn" Content="Crear copias" Icon="{ui:SymbolIcon ImageEdit24}" Appearance="Primary" Click="Go_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
