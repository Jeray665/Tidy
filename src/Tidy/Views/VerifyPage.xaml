<Page x:Class="Tidy.Views.VerifyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Comprobar archivo">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Comprobar un archivo" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="¿Lo que has descargado es el archivo auténtico? Compáralo con la huella (hash) que publica la web oficial. El archivo solo se lee: no se cambia nada." />

        <TextBlock Text="1. El archivo" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="FileName" Text="Ningún archivo elegido" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Elegir archivo…" Icon="{ui:SymbolIcon DocumentSearch24}" Appearance="Primary" Click="Choose_Click" />
            </Grid>
        </Border>

        <TextBlock Text="2. La huella de la web" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Cópiala de la página de descarga (suele llamarse SHA-256, checksum o hash) y pégala aquí. Vale también MD5, SHA-1 o SHA-512." />
                <ui:TextBox x:Name="Expected" PlaceholderText="Por ejemplo: 3f7a9c…" FontFamily="Consolas" TextChanged="Expected_Changed" />
                <TextBlock x:Name="ExpectedKind" Style="{StaticResource Muted}" Margin="2,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Center" Margin="0,0,16,0" Maximum="1" Visibility="Collapsed" />
            <ui:Button x:Name="CheckBtn" Grid.Column="1" Content="Comprobar" Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Primary" Click="Check_Click" IsEnabled="False" />
        </Grid>

        <StackPanel x:Name="Result" Margin="0,16,0,0" />
    </StackPanel>
</Page>
