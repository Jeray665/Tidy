<Page x:Class="Tidy.Views.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Red">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Red" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Elige un DNS más rápido o que bloquee anuncios, edita el archivo hosts y arregla la conexión. Todo guarda una copia de cómo estaba." />

        <TextBlock Text="Tu conexión" Style="{StaticResource Section}" />
        <ItemsControl x:Name="AdapterList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Margin="0,0,0,8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="26" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:InfoBar x:Name="VpnBar" Severity="Informational" IsClosable="False" Margin="0,4,0,0" Title="VPN activa" />

        <Grid Margin="2,24,0,10">
            <TextBlock Text="Servidor DNS" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="MeasureBtn" Content="Medir velocidad" Icon="{ui:SymbolIcon TopSpeed24}" Click="Measure_Click" />
                <ui:Button x:Name="RestoreDnsBtn" Content="Restaurar DNS original" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="8,0,0,0" Click="RestoreDns_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Muted}" Margin="2,-4,0,10"
                   Text="El DNS traduce nombres de webs a direcciones. Uno rápido hace que las webs empiecen a cargar antes. Se aplica a todas tus conexiones activas." />
        <ItemsControl x:Name="ProviderList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardAction Margin="0,0,0,6" Padding="16,10" Tag="{Binding}" Click="Provider_Click" IsChevronVisible="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding LatencyText}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" Foreground="{Binding LatencyBrush}" />
                            <Border Grid.Column="2" Style="{StaticResource Pill}" Visibility="{Binding CurrentVisibility}" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="En uso" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </ui:CardAction>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Archivo hosts" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon ShieldProhibited24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Bloquear anuncios, rastreadores y malware en todo el PC" FontWeight="SemiBold" />
                    <TextBlock x:Name="BlockText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Añade la lista pública de StevenBlack (unos 80.000 dominios) al archivo hosts. Funciona en navegadores, juegos y apps. Alguna web puede fallar: se quita con un clic." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="BlockToggle" Click="Block_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Proteger el archivo hosts (solo lectura)" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Impide que otros programas lo modifiquen a escondidas (un truco típico del malware para redirigirte a webs falsas)." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="LockToggle" Click="Lock_Click" />
        </ui:CardControl>
        <ui:CardAction Icon="{ui:SymbolIcon DocumentEdit24}" Margin="0,0,0,6" Click="EditHosts_Click">
            <StackPanel>
                <TextBlock Text="Editar el archivo hosts a mano" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Text="Antes de guardar se hace una copia; las versiones anteriores están en Copias de seguridad." />
            </StackPanel>
        </ui:CardAction>

        <TextBlock Text="Ping" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="PingHost" Text="google.com" PlaceholderText="Web o IP (ej. google.com, 1.1.1.1)" />
                    <ui:Button Grid.Column="1" Content="Medir latencia" Margin="8,0,0,0" Click="Ping_Click" />
                </Grid>
                <TextBlock x:Name="PingResult" Margin="0,10,0,0" Style="{StaticResource Muted}" Text="Mide cuánto tarda tu conexión en llegar a un servidor (media de 3 intentos)." />
            </StackPanel>
        </Border>

        <TextBlock Text="Reparar la conexión" Style="{StaticResource Section}" />
        <StackPanel x:Name="NetFixes" />
    </StackPanel>
</Page>
