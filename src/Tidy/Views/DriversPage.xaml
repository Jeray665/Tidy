<Page x:Class="Tidy.Views.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Drivers">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Solo fuentes oficiales: Windows Update (drivers firmados por Microsoft) y la web de NVIDIA, con la firma verificada. Antes de instalar se crea un punto de restauración." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0" Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="88" Height="88">
                    <ui:ProgressRing x:Name="Ring" Width="88" Height="88" IsIndeterminate="False" Progress="0" />
                    <ui:SymbolIcon x:Name="StatusIcon" Symbol="ArrowSync24" FontSize="34" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="Comprueba tus drivers" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"
                               Text="Detectamos tus componentes y buscamos versiones oficiales más nuevas." />
                    <ProgressBar x:Name="InstallBar" Margin="0,12,0,0" Maximum="100" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="ScanBtn" Content="Escanear" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Padding="20,12" Click="Scan_Click" />
                    <ui:Button x:Name="UpdateAllBtn" Content="Actualizar todo" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Padding="20,12" Margin="10,0,0,0"
                               Visibility="Collapsed" Click="UpdateSelected_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:InfoBar x:Name="RebootBar" Margin="0,12,0,0" Severity="Warning" IsClosable="True" IsOpen="False"
                    Title="Reinicia para terminar" Message="Algún driver necesita reiniciar el PC para completarse." />

        <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
            <TextBlock Text="Actualizaciones disponibles" Style="{StaticResource Section}" />
            <ItemsControl x:Name="Updates">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tile}" Padding="18,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Device}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Pill}" Background="{Binding SourceBrush}">
                                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
                                        <Run Text="{Binding Class, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" /><Run Text="  ·  publicado " /><Run Text="{Binding NewDateText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Margin="8,0" />
                                    <TextBlock Text="{Binding NewVersion}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                </StackPanel>
                                <ui:Button Grid.Column="3" Content="Actualizar" Tag="{Binding Update}" Click="UpdateOne_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="DevicesPanel" Visibility="Collapsed">
            <TextBlock x:Name="DevicesTitle" Text="Tus dispositivos" Style="{StaticResource Section}" />
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="4,0,0,6" />
                            <Border Style="{StaticResource Tile}" Padding="18,6">
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Device}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}" />
                                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="8,0" Visibility="{Binding Old, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Driver de hace más de 3 años. Si el dispositivo funciona bien no pasa nada.">
                                                    <TextBlock Text="Antiguo" FontSize="11" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</Page>
