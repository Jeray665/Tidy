<Page x:Class="Tidy.Views.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Servicios y tareas">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Servicios y tareas" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Control total de lo que Windows ejecuta en segundo plano. Antes de cambiar algo se guarda cómo estaba, y los imprescindibles (seguridad, red, audio, actualizaciones, inicio de sesión) están bloqueados para que no rompas Windows." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Wand24" FontSize="26" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UnneededTitle" Text="Buscando lo que está activo sin hacer falta…" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock x:Name="UnneededSub" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Servicios y tareas de Windows y de tus programas que gastan recursos sin que los uses." />
                </StackPanel>
                <ui:Button x:Name="UnneededBtn" Grid.Column="2" Appearance="Primary" Content="Ver la lista…" IsEnabled="False" VerticalAlignment="Center" Click="Unneeded_Click" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="0,14,0,0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" /><TextBlock Text="Servicios" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SvcSearch" PlaceholderText="Buscar servicio…" Icon="{ui:SymbolIcon Search24}" TextChanged="SvcFilter_Changed" />
                        <ComboBox x:Name="SvcFilter" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="SvcFilter_Changed">
                            <ComboBoxItem Content="Todos" />
                            <ComboBoxItem Content="Con consejo de Tidy" />
                            <ComboBoxItem Content="Cambiados por Tidy" />
                            <ComboBoxItem Content="En ejecución" />
                            <ComboBoxItem Content="Deshabilitados" />
                            <ComboBoxItem Content="De terceros (no Microsoft)" />
                        </ComboBox>
                        <ui:Button x:Name="SvcRestoreAll" Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}" Content="Restaurar todos" Click="SvcRestoreAll_Click" />
                    </Grid>
                    <TextBlock x:Name="SvcSummary" Style="{StaticResource Muted}" Margin="2,0,0,8" />
                    <ListBox x:Name="SvcList" Style="{StaticResource RowList}" Height="600">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" VerticalAlignment="Center" ToolTip="{Binding StateText}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <ui:SymbolIcon Symbol="LockClosed16" Margin="6,0,0,0" FontSize="13" Visibility="{Binding LockVisibility}"
                                                           ToolTip="Protegido: Windows lo necesita para funcionar" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Border Style="{StaticResource Pill}" Visibility="{Binding ChangedVisibility}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                                <TextBlock Text="Cambiado por Tidy" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Info.Description}" />
                                        <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Visibility="{Binding HintVisibility}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{Binding ModeText}" MinWidth="190" Tag="{Binding}" Click="SvcMode_Click" IsEnabled="{Binding CanChange}"
                                                   Icon="{ui:SymbolIcon ChevronDown16}" ToolTip="Tipo de inicio" />
                                        <ui:Button Icon="{Binding RunIcon}" Padding="8,5" Margin="6,0,0,0" Tag="{Binding}" Click="SvcRun_Click" IsEnabled="{Binding CanChange}"
                                                   ToolTip="{Binding RunTip}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CalendarClock24" Margin="0,0,6,0" /><TextBlock Text="Tareas programadas" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TaskSearch" PlaceholderText="Buscar tarea…" Icon="{ui:SymbolIcon Search24}" TextChanged="TaskFilter_Changed" />
                        <ComboBox x:Name="TaskFilter" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="1" SelectionChanged="TaskFilter_Changed">
                            <ComboBoxItem Content="Todas (incluidas las de Windows)" />
                            <ComboBoxItem Content="Las que puedes cambiar" />
                            <ComboBoxItem Content="Con consejo de Tidy" />
                            <ComboBoxItem Content="Cambiadas por Tidy" />
                            <ComboBoxItem Content="Desactivadas" />
                        </ComboBox>
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}" Content="Restaurar todas" Click="TaskRestoreAll_Click" />
                    </Grid>
                    <TextBlock x:Name="TaskSummary" Style="{StaticResource Muted}" Margin="2,0,0,8" />
                    <ListBox x:Name="TaskList" Style="{StaticResource RowList}" Height="600">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <ui:SymbolIcon Symbol="LockClosed16" Margin="6,0,0,0" FontSize="13" Visibility="{Binding LockVisibility}"
                                                           ToolTip="Tarea de Windows: solo lectura" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Border Style="{StaticResource Pill}" Visibility="{Binding ChangedVisibility}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                                <TextBlock Text="Cambiada por Tidy" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Tip}" />
                                        <TextBlock Text="{Binding Info.Hint}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding HintVisibility}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Info.Enabled, Mode=OneWay}" IsEnabled="{Binding Info.CanChange}" Tag="{Binding}" Click="TaskToggle_Click" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</Page>
