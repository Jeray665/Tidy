<Page x:Class="Tidy.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Herramientas">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Herramientas" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Reparaciones de Windows con un clic y acceso directo a todas las herramientas avanzadas del sistema." />

        <TextBlock Text="Reparar Windows" Style="{StaticResource Section}" />
        <StackPanel x:Name="Fixes" />

        <TextBlock Text="¿Quién está usando este archivo?" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,200,0"
                               Text="Cuando Windows dice &quot;el archivo está en uso&quot; y no te deja borrarlo o moverlo, aquí ves qué programa lo tiene abierto." />
                    <ui:Button HorizontalAlignment="Right" Content="Elegir archivo…" Icon="{ui:SymbolIcon DocumentSearch24}" Click="WhoLocks_Click" />
                </Grid>
                <StackPanel x:Name="LockResult" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="Herramientas de Windows" Style="{StaticResource Section}" />
        <UniformGrid x:Name="ToolGrid" Columns="3" />
    </StackPanel>
</Page>
