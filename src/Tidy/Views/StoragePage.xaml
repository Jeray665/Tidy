<Page x:Class="Tidy.Views.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Tidy"
      xmlns:v="clr-namespace:Tidy.Views"
      Title="Almacenamiento">

    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Almacenamiento" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Descubre qué ocupa tu disco. Aquí nada se borra para siempre: lo que elijas va a la Papelera de reciclaje y se puede recuperar." />

        <ItemsControl x:Name="Drives" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Storage24" FontSize="30" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="8" Margin="0,8,0,0" Foreground="{Binding Brush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Salud de los discos" Style="{StaticResource Section}" Margin="2,10,0,8" />
        <StackPanel x:Name="DiskHealthList">
            <TextBlock Text="Leyendo el estado de los discos…" Style="{StaticResource Muted}" Margin="2,0,0,8" />
        </StackPanel>

        <UniformGrid Columns="3" Margin="0,8,0,0">
            <ui:CardAction Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,8" VerticalAlignment="Stretch" Click="DeepClean_Click">
                <StackPanel>
                    <TextBlock Text="Limpieza profunda" FontWeight="SemiBold" />
                    <TextBlock Text="Temporales, cachés y restos de Windows Update" Style="{StaticResource Muted}" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,8" VerticalAlignment="Stretch" Click="ShowDownloads_Click">
                <StackPanel>
                    <TextBlock Text="Archivos descargados" FontWeight="SemiBold" />
                    <TextBlock x:Name="DownloadsCardText" Text="Calculando…" Style="{StaticResource Muted}" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction Icon="{ui:SymbolIcon Storage24}" Margin="0,0,0,8" VerticalAlignment="Stretch" Click="StorageSense_Click">
                <StackPanel>
                    <TextBlock Text="Sensor de almacenamiento" FontWeight="SemiBold" />
                    <TextBlock Text="Limpieza automática de Windows" Style="{StaticResource Muted}" />
                </StackPanel>
            </ui:CardAction>
        </UniformGrid>

        <TabControl x:Name="Tabs" Margin="0,12,0,0">
            <!-- ======= what takes space + large files ======= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DataPie24" Margin="0,0,6,0" /><TextBlock Text="Análisis de disco" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ScanDrive" />
                        <ui:Button x:Name="ScanBtn" Grid.Column="1" Content="Analizar" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Margin="8,0,0,0" Click="Scan_Click" />
                        <TextBlock x:Name="ScanStatus" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="Recorre el disco una vez (1-3 minutos) y te dice qué carpetas y archivos ocupan más." />
                    </Grid>
                    <StackPanel x:Name="ScanResults" Margin="0,14,0,0" Visibility="Collapsed">
                        <v:FileTable x:Name="LargeTable" StartSize="2" Hint="Marca archivos para moverlos o enviarlos a la Papelera. Los de Windows, programas y juegos no se pueden marcar.">
                            <v:FileTable.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Mover a otra carpeta…" Icon="{ui:SymbolIcon FolderArrowRight24}" Tag="LargeTable" Click="Move_Click" />
                                    <ui:Button Content="Enviar a la Papelera" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Margin="8,0,0,0" Tag="LargeTable" Click="Recycle_Click" />
                                </StackPanel>
                            </v:FileTable.Actions>
                        </v:FileTable>

                        <TextBlock Text="Carpetas que más ocupan" Style="{StaticResource Section}" />
                        <StackPanel>
                            <ListBox x:Name="FolderList" Style="{StaticResource RowList}" Height="420" MouseDoubleClick="FolderList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding Path}">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" FontSize="13" />
                                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" />
                                            </Grid>
                                            <TextBlock Text="{Binding Parent}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Doble clic para abrir la carpeta." Style="{StaticResource Muted}" Margin="2,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ======= downloads ======= -->
            <TabItem x:Name="DownloadsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" /><TextBlock Text="Descargas" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <Grid>
                        <TextBlock x:Name="DownloadsInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Marcar instaladores y comprimidos de más de 30 días" Click="SelectOldInstallers_Click" Margin="0,0,6,0" />
                            <ui:Button Content="Desmarcar todo" Click="UnselectDownloads_Click" />
                        </StackPanel>
                    </Grid>
                    <v:FileTable x:Name="DownloadTable" Margin="0,10,0,0" Hint="Marca archivos para moverlos o enviarlos a la Papelera.">
                        <v:FileTable.Actions>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Mover a otra carpeta…" Icon="{ui:SymbolIcon FolderArrowRight24}" Tag="DownloadTable" Click="Move_Click" />
                                <ui:Button Content="Enviar a la Papelera" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Margin="8,0,0,0" Tag="DownloadTable" Click="Recycle_Click" />
                            </StackPanel>
                        </v:FileTable.Actions>
                    </v:FileTable>
                </StackPanel>
            </TabItem>

            <!-- ======= duplicates ======= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentCopy24" Margin="0,0,6,0" /><TextBlock Text="Duplicados" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Busca archivos idénticos byte a byte (no solo con el mismo nombre). En cada grupo se marcan todas las copias menos la más antigua, y Tidy nunca deja que borres todas." />
                    <TextBlock x:Name="DupFolders" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button x:Name="DupBtn" Content="Buscar duplicados" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Click="Duplicates_Click" />
                        <ui:Button Content="Añadir carpeta…" Icon="{ui:SymbolIcon FolderAdd24}" Margin="8,0,0,0" Click="AddDupFolder_Click" />
                        <ComboBox x:Name="DupMin" Margin="8,0,0,0" SelectedIndex="1" Width="190">
                            <ComboBoxItem Content="Archivos de más de 100 KB" Tag="102400" />
                            <ComboBoxItem Content="Archivos de más de 1 MB" Tag="1048576" />
                            <ComboBoxItem Content="Archivos de más de 50 MB" Tag="52428800" />
                        </ComboBox>
                        <TextBlock x:Name="DupStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <v:FileTable x:Name="DupTable" Margin="0,12,0,0" Visibility="Collapsed" Hint="En cada grupo se marcan todas las copias menos la más antigua. Tidy nunca deja que borres todas.">
                        <v:FileTable.Actions>
                            <ui:Button Content="Enviar copias marcadas a la Papelera" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Tag="DupTable" Click="Recycle_Click" />
                        </v:FileTable.Actions>
                    </v:FileTable>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</Page>
