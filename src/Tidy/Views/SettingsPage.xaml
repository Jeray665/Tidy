<Page x:Class="Tidy.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ajustes">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Ajustes" Style="{StaticResource PageTitle}" />

        <TextBlock Text="General" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Arrancar con Windows" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Tidy se instala en Archivos de programa (protegido) y arranca en la bandeja con permisos de administrador mediante una tarea de Windows, sin aviso de UAC." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="Autostart" Click="Autostart_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Flash24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Liberación automática de RAM" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Libera la memoria en espera cuando la memoria libre baja del límite. Ajusta el límite en Rendimiento." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AutoRam" Click="AutoRam_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Recordatorio de limpieza" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Si hace tiempo que no limpias y hay más de 300 MB que liberar, te avisa con una notificación. Nunca borra nada por su cuenta." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="Reminder" Width="170" SelectionChanged="Reminder_Changed">
                <ComboBoxItem Content="Desactivado" Tag="0" />
                <ComboBoxItem Content="Cada semana" Tag="7" />
                <ComboBoxItem Content="Cada mes" Tag="30" />
            </ComboBox>
        </ui:CardControl>

        <TextBlock Text="Seguridad" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="  Cómo te protege Tidy" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" LineHeight="22">
                    • Nada se borra sin enseñarte antes la lista exacta de archivos y sin tu confirmación.<LineBreak />
                    • Solo limpia carpetas de una lista blanca, no entra nunca en enlaces/junctions y no toca temporales de menos de 24 h.<LineBreak />
                    • Cada optimización guarda el valor original antes de cambiar nada y se deshace con su interruptor.<LineBreak />
                    • Punto de restauración de Windows antes de optimizaciones, drivers y desinstalar apps.<LineBreak />
                    • Drivers solo de Windows Update o nvidia.com; el instalador de NVIDIA se rechaza si su firma digital no es válida.<LineBreak />
                    • La RAM se libera vaciando solo la caché en espera: no cierra programas ni pierde datos.<LineBreak />
                    • Sin telemetría: solo se conecta cuando tú lo pides (Windows Update y nvidia.com para drivers, winget para instalar o actualizar apps, la lista de bloqueo de anuncios).<LineBreak />
                    • Todo lo que hace queda apuntado en un registro que puedes revisar.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <ui:Button Content="Ver registro de actividad" Icon="{ui:SymbolIcon History24}" Click="OpenLog_Click" />
                    <ui:Button Content="Abrir carpeta de datos" Icon="{ui:SymbolIcon Folder24}" Margin="8,0,0,0" Click="OpenFolder_Click" />
                    <ui:Button Content="Restaurar sistema…" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Margin="8,0,0,0" Click="Restore_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Acerca de" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/tidy.png" Width="44" Height="44" />
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Optimizador seguro para Windows 11" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Salir de Tidy" Icon="{ui:SymbolIcon Dismiss24}" VerticalAlignment="Center" Click="Quit_Click"
                           ToolTip="Cierra también el icono de la bandeja" />
            </Grid>
        </Border>
    </StackPanel>
</Page>
