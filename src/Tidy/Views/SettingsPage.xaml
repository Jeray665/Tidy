<Page x:Class="Tidy.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ajustes">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Ajustes" Style="{StaticResource PageTitle}" />

        <TextBlock Text="General" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Arrancar con Windows" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Tidy se instala en Archivos de programa (protegido) y arranca en la bandeja con permisos de administrador mediante una tarea de Windows, sin aviso de UAC." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="Autostart" Click="Autostart_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Tema" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Claro u oscuro, o el mismo que Windows. El icono de Tidy cambia con el tema." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="ThemeBox" Width="170" SelectionChanged="Theme_Changed">
                <ComboBoxItem Content="Como Windows" Tag="system" />
                <ComboBoxItem Content="Claro" Tag="light" />
                <ComboBoxItem Content="Oscuro" Tag="dark" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Idioma (Language)" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Español o inglés. Se aplica al reiniciar Tidy." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="LanguageBox" Width="170" SelectionChanged="Language_Changed">
                <ComboBoxItem Content="Como Windows" Tag="" />
                <ComboBoxItem Content="Español" Tag="es" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Flash24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Liberación automática de RAM" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Libera la memoria en espera cuando la memoria libre baja del límite. Ajusta el límite en Rendimiento." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AutoRam" Click="AutoRam_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Recordatorio de limpieza" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Si hace tiempo que no limpias y hay más de 300 MB que liberar, te avisa con una notificación. Nunca borra nada por su cuenta." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="Reminder" Width="170" SelectionChanged="Reminder_Changed">
                <ComboBoxItem Content="Desactivado" Tag="0" />
                <ComboBoxItem Content="Cada semana" Tag="7" />
                <ComboBoxItem Content="Cada mes" Tag="30" />
            </ComboBox>
        </ui:CardControl>

        <TextBlock Text="Seguridad" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="  Cómo te protege Tidy" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" LineHeight="22" TextWrapping="Wrap"
                           Text="• Nada se borra sin enseñarte antes la lista exacta de archivos y sin tu confirmación.&#10;• Solo limpia carpetas de una lista blanca, no entra nunca en enlaces/junctions y no toca temporales de menos de 24 h.&#10;• Cada optimización guarda el valor original antes de cambiar nada y se deshace con su interruptor.&#10;• Punto de restauración de Windows antes de optimizaciones, drivers y desinstalar apps.&#10;• Drivers solo de Windows Update o nvidia.com; el instalador de NVIDIA se rechaza si su firma digital no es válida.&#10;• La RAM se libera vaciando solo la caché en espera: no cierra programas ni pierde datos.&#10;• Sin telemetría: solo se conecta cuando tú lo pides (Windows Update y nvidia.com para drivers, winget para instalar o actualizar apps, la lista de bloqueo de anuncios) y una vez al día a GitHub para ver si hay versión nueva (se puede desactivar).&#10;• Todo lo que hace queda apuntado en un registro que puedes revisar." />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <ui:Button Content="Ver registro de actividad" Icon="{ui:SymbolIcon History24}" Click="OpenLog_Click" />
                    <ui:Button Content="Abrir carpeta de datos" Icon="{ui:SymbolIcon Folder24}" Margin="8,0,0,0" Click="OpenFolder_Click" />
                    <ui:Button Content="Restaurar sistema…" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Margin="8,0,0,0" Click="Restore_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Versión y actualizaciones" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}" Margin="0,0,0,6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{DynamicResource AppLogo}" Width="48" Height="48" />
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="CheckBtn" Content="Buscar actualizaciones" Icon="{ui:SymbolIcon ArrowSync24}" Click="Check_Click" />
                        <ui:Button x:Name="UpdateBtn" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="8,0,0,0" Visibility="Collapsed" Click="Update_Click" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,14,0,0" Visibility="Collapsed" />
                <WrapPanel Margin="62,12,0,0">
                    <ui:Button Content="Novedades" Icon="{ui:SymbolIcon Sparkle24}" Click="WhatsNew_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Tidy en GitHub" Icon="{ui:SymbolIcon Open24}" Click="GitHub_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Salir de Tidy" Icon="{ui:SymbolIcon Dismiss24}" Click="Quit_Click" ToolTip="Cierra también el icono de la bandeja" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <ui:CardControl Icon="{ui:SymbolIcon Globe24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Buscar actualizaciones automáticamente" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Una vez al día mira en GitHub si hay una versión nueva y te avisa. Nunca instala nada sin que pulses Actualizar." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AutoUpdate" Click="AutoUpdate_Click" />
        </ui:CardControl>

        <StackPanel x:Name="RetiredBox" Visibility="Collapsed">
            <TextBlock Text="Funciones retiradas" Style="{StaticResource Section}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="2,0,0,10"
                       Text="Optimizaciones que ya no están en esta versión pero que tenías activadas. Siguen aplicadas; aquí puedes devolver su valor original." />
            <StackPanel x:Name="RetiredList" />
        </StackPanel>
    </StackPanel>
</Page>
