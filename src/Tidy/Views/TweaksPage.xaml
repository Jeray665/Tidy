<Page x:Class="Tidy.Views.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Optimizaciones">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Optimizaciones" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Cada interruptor guarda el valor original antes de cambiar nada y se deshace apagándolo. Antes del primer cambio se crea un punto de restauración. Pulsa ⓘ en cualquiera para ver exactamente qué toca." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon Symbol="Wand24" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Summary" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummarySub" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Deshacer todo" Icon="{ui:SymbolIcon ArrowUndo24}" VerticalAlignment="Center" Click="RevertAll_Click" />
            </Grid>
        </Border>

        <TextBlock Text="Perfiles" Style="{StaticResource Section}" />
        <TextBlock Style="{StaticResource Muted}" Margin="2,-4,0,10"
                   Text="Aplican de golpe un conjunto de optimizaciones. Antes de aplicar verás la lista completa de lo que va a cambiar." />
        <UniformGrid x:Name="Presets" Columns="2" />

        <Grid Margin="0,26,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Buscar entre todas las optimizaciones…" Icon="{ui:SymbolIcon Search24}" TextChanged="Filter_Changed" />
            <ComboBox x:Name="GroupFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="StateFilter" Grid.Column="2" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Todas" />
                <ComboBoxItem Content="Activadas" />
                <ComboBoxItem Content="Sin activar" />
            </ComboBox>
        </Grid>
        <TextBlock x:Name="NoResults" Text="Ninguna optimización coincide con la búsqueda." Style="{StaticResource Muted}" Margin="2,12" Visibility="Collapsed" />

        <StackPanel x:Name="Groups" />

        <Expander Margin="0,24,0,0" Padding="16">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ShieldError24" Margin="0,0,10,0" />
                    <TextBlock Text="Lo que Tidy NO hace a propósito (y otros optimizadores sí)" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>
            <StackPanel x:Name="NotIncluded" />
        </Expander>

        <TextBlock Text="Apps preinstaladas" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Quitar apps que Windows instala sin preguntar" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="Solo se ofrecen apps de una lista segura (nunca la Store, Xbox, Fotos, Calculadora…). Todas se pueden volver a instalar gratis desde Microsoft Store. Para cualquier otro programa usa Aplicaciones › Desinstalar en profundidad." />
                    </StackPanel>
                    <ui:Button x:Name="FindAppsBtn" Grid.Column="1" Content="Buscar apps" Icon="{ui:SymbolIcon Search24}" VerticalAlignment="Center" Margin="16,0,0,0" Click="FindApps_Click" />
                </Grid>
                <ItemsControl x:Name="Apps" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button x:Name="RemoveAppsBtn" Content="Desinstalar seleccionadas" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                           Margin="0,12,0,0" Visibility="Collapsed" Click="RemoveApps_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
