<Page x:Class="Tidy.Views.VideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Vídeo y audio">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Vídeo y audio" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Comprime vídeos para que ocupen mucho menos, o saca solo el sonido. Los originales no se tocan: cada uno se guarda como una copia nueva." />

        <!-- 1 · which files -->
        <TextBlock Text="1. Elige los vídeos" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FilesInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                               Text="MP4, MOV, MKV, AVI, WMV y más. También audio: MP3, WAV, FLAC, M4A y WMA." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Añadir vídeos…" Icon="{ui:SymbolIcon VideoAdd24}" Appearance="Primary" Click="AddFiles_Click" />
                        <ui:Button Content="Añadir una carpeta…" Icon="{ui:SymbolIcon FolderAdd24}" Margin="6,0,0,0" Click="AddFolder_Click" />
                        <ui:Button x:Name="ClearBtn" Content="Quitar todos" Margin="6,0,0,0" Click="Clear_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <ListBox x:Name="FileList" Style="{StaticResource RowList}" Height="240" Margin="0,12,0,0" Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Video24" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="18,0,8,0" ToolTip="{Binding Status}" />
                                <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Dismiss16}" Padding="7,5" ToolTip="Quitar de la lista" Tag="{Binding}" Click="Remove_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 2 · what to do -->
        <TextBlock Text="2. Qué hacer con ellos" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Qué hacer" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <ComboBox x:Name="ModeBox" Grid.Column="1" Width="380" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="Options_Changed">
                    <ComboBoxItem Content="Comprimir el vídeo (MP4, se abre en todas partes)" Tag="mp4" />
                    <ComboBoxItem Content="Sacar solo el sonido en MP3" Tag="mp3" />
                    <ComboBoxItem Content="Sacar solo el sonido en M4A (mejor calidad)" Tag="m4a" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="Calidad" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,24,0" />
                <ComboBox x:Name="QualityBox" Grid.Row="1" Grid.Column="1" Width="380" HorizontalAlignment="Left" Margin="0,14,0,0" SelectedIndex="1">
                    <ComboBoxItem Content="Alta · se ve como el original" Tag="0" />
                    <ComboBoxItem Content="Equilibrada · ocupa mucho menos (recomendado)" Tag="1" />
                    <ComboBoxItem Content="Pequeña · para enviar por WhatsApp o correo" Tag="2" />
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Tamaño" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,24,0" />
                <ComboBox x:Name="SizeBox" Grid.Row="2" Grid.Column="1" Width="380" HorizontalAlignment="Left" Margin="0,14,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="El original" Tag="0" />
                    <ComboBoxItem Content="Como mucho 1080p (Full HD)" Tag="1080" />
                    <ComboBoxItem Content="Como mucho 720p" Tag="720" />
                    <ComboBoxItem Content="Como mucho 480p (ocupa muy poco)" Tag="480" />
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Guardar en" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,18,24,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                    <RadioButton x:Name="NextTo" GroupName="Dest" IsChecked="True" Content="La misma carpeta que cada original, como &quot;nombre (Tidy).mp4&quot;" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="Elsewhere" GroupName="Dest" Content="Otra carpeta" Checked="Elsewhere_Checked" />
                        <ui:Button x:Name="DestBtn" Content="Elegir…" Margin="10,0,0,0" Click="ChooseDest_Click" />
                        <TextBlock x:Name="DestText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,10,0,0"
                   Text="Usa la tarjeta gráfica cuando puede y trabaja con prioridad baja, así que puedes seguir usando el PC mientras tanto." />

        <!-- 3 · go -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="Status" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="OpenBtn" Content="Abrir carpeta" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0" Click="Open_Click" Visibility="Collapsed" />
                <ui:Button x:Name="CancelBtn" Content="Cancelar" Margin="0,0,8,0" Click="Cancel_Click" Visibility="Collapsed" />
                <ui:Button x:Name="GoBtn" Content="Crear copias" Icon="{ui:SymbolIcon VideoClip24}" Appearance="Primary" Click="Go_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
