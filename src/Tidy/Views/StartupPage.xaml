<Page x:Class="Tidy.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Inicio de Windows">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Inicio de Windows" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Apps que se abren solas al encender el PC. Desactivarlas no las desinstala: es lo mismo que hace el Administrador de tareas y puedes volver a activarlas cuando quieras." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Summary" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"
                               Text="Consejo: deja activo lo que uses nada más encender (audio, ratón, nube). El resto se puede abrir cuando lo necesites." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Timer24" FontSize="26" Foreground="{StaticResource BrandBrush}" Margin="13,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="¿Qué alarga el arranque?" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Windows apunta qué retrasó cada arranque del último mes y cuántos segundos. Verás la lista antes de cambiar nada." />
                </StackPanel>
                <ui:Button x:Name="SlowBtn" Grid.Column="2" Appearance="Primary" Content="Ver qué lo alarga" VerticalAlignment="Center" Click="Slow_Click" />
            </Grid>
        </Border>

        <TextBlock Text="Preconfiguraciones" Style="{StaticResource Section}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="2,-4,0,10" TextWrapping="Wrap"
                   Text="Apaga de una vez lo de otros programas que arranca solo y solo quita rendimiento. Antes ves la lista con el motivo de cada cosa y puedes desmarcar lo que quieras. Nunca toca actualizadores, antivirus, audio, ratón y teclado, la nube ni nada de Windows. Todo se deshace desde Historial." />
        <UniformGrid x:Name="Presets" Columns="3" />

        <TextBlock Text="Apps" Style="{StaticResource Section}" />
        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Padding="16,12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="Toggle_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
