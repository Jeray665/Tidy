<Page x:Class="Tidy.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Historial">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Historial" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Todo lo que Tidy ha hecho en tu PC, con su botón para deshacerlo, y si de verdad ha servido para algo." />

        <Grid Margin="2,24,0,10">
            <TextBlock Text="Antes y después" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:Button x:Name="MeasureBtn" Content="Medir ahora" Icon="{ui:SymbolIcon DataBarVertical24}" HorizontalAlignment="Right" Click="Measure_Click" />
        </Grid>
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <Grid x:Name="Compare" />
                <TextBlock x:Name="CompareNote" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="La primera medición se guarda como referencia (el &quot;antes&quot;). Para comparar en igualdad, mide recién arrancado el PC y sin juegos abiertos." />
            </StackPanel>
        </Border>

        <TextBlock Text="Tiempo de arranque de Windows" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <TextBlock x:Name="BootSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap"
                           Text="Lo mide el propio Windows en cada arranque, también los de antes de instalar Tidy. En color, los arranques después del primer cambio de Tidy." />
                <StackPanel x:Name="BootBars" />
            </StackPanel>
        </Border>

        <Grid Margin="2,24,0,10">
            <TextBlock Text="Cambios" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="Filter" Width="220" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Todos los cambios" />
                <ComboBoxItem Content="Solo los que se pueden deshacer" />
                <ComboBoxItem Content="Optimizaciones" Tag="Tweak" />
                <ComboBoxItem Content="Servicios y tareas" Tag="Service,Task" />
                <ComboBoxItem Content="Red" Tag="Network" />
                <ComboBoxItem Content="Apps y desinstalaciones" Tag="App,Uninstall,Startup" />
                <ComboBoxItem Content="Limpieza y archivos" Tag="Clean,Files" />
                <ComboBoxItem Content="Energía y modo juego" Tag="Power,Game" />
            </ComboBox>
        </Grid>
        <StackPanel x:Name="Entries" />
        <ui:Button x:Name="MoreBtn" Content="Ver más" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" Click="More_Click" />
    </StackPanel>
</Page>
