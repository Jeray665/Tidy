<Page x:Class="Tidy.Views.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Copias de seguridad">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Copias de seguridad" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Todo lo que Tidy cambia se puede deshacer desde aquí. Las copias de servicios, DNS, hosts y la cuarentena se guardan en una carpeta que solo pueden modificar los administradores." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RestoreTitle" FontSize="20" FontWeight="SemiBold" Text="Punto de restauración" />
                    <TextBlock x:Name="RestoreSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Abrir Restaurar sistema" Icon="{ui:SymbolIcon History24}" VerticalAlignment="Center" Click="Rstrui_Click" />
            </Grid>
        </Border>

        <StackPanel x:Name="Sections" />

        <TextBlock Text="Exportar e importar configuración" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon ArrowExportUp24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Llévate tus optimizaciones a otro PC" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Guarda qué optimizaciones tienes activadas en un archivo. Al importarlo verás la lista antes de aplicar nada; solo se aceptan optimizaciones del propio catálogo de Tidy." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Exportar…" Click="Export_Click" />
                <ui:Button Content="Importar…" Margin="8,0,0,0" Click="Import_Click" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
