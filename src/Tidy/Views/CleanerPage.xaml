<Page x:Class="Tidy.Views.CleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Limpieza">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Limpieza" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Nada se borra sin tu confirmación: antes verás la lista exacta de archivos. Los que estén en uso se saltan solos." />

        <Border Style="{StaticResource Tile}" Margin="0,18,0,0" Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon Symbol="Broom24" FontSize="30" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalText" Text="Analiza tu PC" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalSub" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" Text="Descubre cuánto espacio puedes recuperar." />
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="ScanBtn" Content="Analizar" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Padding="20,12" Click="Scan_Click" />
                    <ui:Button x:Name="CleanBtn" Content="Limpiar" Icon="{ui:SymbolIcon Delete24}" Appearance="Primary" Padding="20,12" Margin="10,0,0,0" Click="Clean_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ResultCard" Style="{StaticResource Tile}" Margin="0,12,0,0" Visibility="Collapsed"
                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="ResultText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Column="2" Content="Ver lista de lo borrado" Appearance="Transparent" Click="OpenList_Click" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Tile}" Margin="0,12,0,0" Padding="18,14">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="DiskLabel" Text="Disco" FontWeight="SemiBold" />
                    <TextBlock x:Name="DiskFree" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                </Grid>
                <ProgressBar x:Name="DiskBar" Height="6" Margin="0,10,0,0" Maximum="100" />
            </StackPanel>
        </Border>

        <TextBlock Text="Qué limpiar" Style="{StaticResource Section}" />
        <ItemsControl x:Name="Cats">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Padding="18,14" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="22" Margin="4,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="90">
                                    <TextBlock Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                            <Expander Header="{Binding ExpandText}" Margin="0,10,0,0" Visibility="{Binding ListVisibility}">
                                <ListBox ItemsSource="{Binding Items}" Height="240" Style="{StaticResource FileList}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
