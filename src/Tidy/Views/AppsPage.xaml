<Page x:Class="Tidy.Views.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Aplicaciones">
    <StackPanel Margin="36,20,36,36">
        <TextBlock Text="Aplicaciones" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Desinstala programas sin dejar rastro y controla lo que se está ejecutando." />

        <TabControl x:Name="Tabs" Margin="0,18,0,0" SelectionChanged="Tabs_SelectionChanged">
            <!-- ================= Deep uninstall ================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" /><TextBlock Text="Desinstalar en profundidad" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource Tile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="26" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AppsSummary" FontSize="20" FontWeight="SemiBold" Text="Cargando programas…" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"
                                           Text="1) Se crea un punto de restauración. 2) Se abre el desinstalador del propio programa. 3) Tidy busca los restos (carpetas, registro, accesos directos, servicios, tareas) y te deja elegir. Los restos no se borran: van a la cuarentena y se pueden restaurar." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="AppSearch" PlaceholderText="Buscar programa o fabricante…" Icon="{ui:SymbolIcon Search24}" TextChanged="AppSearch_Changed" />
                        <ComboBox x:Name="AppSort" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="AppSearch_Changed">
                            <ComboBoxItem Content="Ordenar por nombre" />
                            <ComboBoxItem Content="Ordenar por tamaño" />
                            <ComboBoxItem Content="Más recientes primero" />
                        </ComboBox>
                    </Grid>
                    <ListBox x:Name="AppList" Style="{StaticResource RowList}" Height="560">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Image Source="{Binding Icon}" Width="32" Height="32" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Pill}" Visibility="{Binding SharedVisibility}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    ToolTip="Otros programas lo necesitan para funcionar. Desinstálalo solo si sabes que no se usa.">
                                                <TextBlock Text="Compartido" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                    <ui:Button Grid.Column="3" Content="Desinstalar" Margin="14,0,0,0" Tag="{Binding}" Click="Uninstall_Click" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <!-- ================= Processes ================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TaskListLtr24" Margin="0,0,6,0" /><TextBlock Text="Procesos" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource Tile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                                <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="26" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProcSummary" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"
                                           Text="Se actualiza cada 2 segundos mientras esta pestaña está abierta. Los procesos de Windows imprescindibles no se pueden cerrar desde aquí." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="26" Foreground="{StaticResource BrandBrush}" Margin="13,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BgTitle" Text="¿Qué gasta en segundo plano?" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="BgSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Mide durante 10 segundos los programas abiertos sin ventana (bandeja, launchers, ayudantes). Verás qué gasta cada uno antes de cambiar nada." />
                            </StackPanel>
                            <ui:Button x:Name="BgBtn" Grid.Column="2" Appearance="Primary" Content="Analizar" VerticalAlignment="Center" Click="Background_Click" />
                        </Grid>
                    </Border>
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ProcSearch" PlaceholderText="Buscar proceso…" Icon="{ui:SymbolIcon Search24}" TextChanged="ProcSort_Changed" />
                        <ComboBox x:Name="ProcSort" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="ProcSort_Changed">
                            <ComboBoxItem Content="Más memoria primero" />
                            <ComboBoxItem Content="Más CPU primero" />
                            <ComboBoxItem Content="Por nombre" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="56,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Programa" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource ColHeader}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Memoria" Style="{StaticResource ColHeader}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox x:Name="ProcList" Style="{StaticResource RowList}" Height="560">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="WindowApps24" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Image Source="{Binding Icon}" Width="24" Height="24" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="18,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding MemText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}" Padding="8,5" Tag="{Binding}" Click="ProcMore_Click" ToolTip="Más acciones" />
                                        <ui:Button Content="Cerrar" Margin="6,0,0,0" Tag="{Binding}" Click="ProcClose_Click" IsEnabled="{Binding CanClose}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <!-- ================= winget: update & install ================= -->
            <TabItem x:Name="WingetTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" /><TextBlock Text="Actualizar e instalar" /></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                    <ui:InfoBar x:Name="WingetMissing" Severity="Warning" IsClosable="False" Title="Falta winget"
                                Message="Instala o actualiza &quot;Instalador de aplicación&quot; desde Microsoft Store y vuelve a abrir esta pestaña." />
                    <Border Style="{StaticResource Tile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandBrush}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="26" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdatesSummary" FontSize="20" FontWeight="SemiBold" Text="Buscando actualizaciones…" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"
                                           Text="Usa winget, el gestor de apps de Microsoft: descarga cada programa de la web de su fabricante y comprueba su huella (SHA-256) antes de instalarlo. Antes se crea un punto de restauración." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="RecheckUpdatesBtn" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Buscar de nuevo" Padding="9,7" Click="RecheckUpdates_Click" />
                                <ui:Button x:Name="UpdateBtn" Content="Actualizar seleccionadas" Appearance="Primary" Margin="8,0,0,0" Click="UpdateSelected_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="UpdateTools" Orientation="Horizontal" Margin="2,12,0,6">
                        <ui:Button Content="Marcar todo" Margin="0,0,6,0" Click="UpdatesAll_Click" />
                        <ui:Button Content="Desmarcar todo" Click="UpdatesNone_Click" />
                    </StackPanel>
                    <ListBox x:Name="UpdateList" Style="{StaticResource RowList}" MaxHeight="340">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" MinWidth="0" />
                                    <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Instalar apps" Style="{StaticResource Section}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="WingetQuery" PlaceholderText="Buscar cualquier programa en winget (ej. spotify, blender, wireshark)…" Icon="{ui:SymbolIcon Search24}" KeyDown="WingetQuery_KeyDown" />
                        <ui:Button Grid.Column="1" Content="Buscar" Margin="8,0,0,0" Click="WingetSearch_Click" />
                        <ui:Button x:Name="InstallBtn" Grid.Column="2" Content="Instalar seleccionadas" Appearance="Primary" Margin="8,0,0,0" IsEnabled="False" Click="InstallSelected_Click" />
                    </Grid>
                    <StackPanel x:Name="CatalogPanel" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</Page>
