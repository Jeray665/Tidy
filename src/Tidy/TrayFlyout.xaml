<ui:FluentWindow x:Class="Tidy.TrayFlyout"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Tidy" Width="430" SizeToContent="Height"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Acrylic" WindowCornerPreference="Round"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sections rail -->
        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel Margin="9,16,9,12">
                <Image DockPanel.Dock="Top" Source="{DynamicResource AppLogo}" Width="24" Height="24" Margin="0,0,0,18" />
                <ui:Button DockPanel.Dock="Bottom" Appearance="Transparent" Width="40" Height="40" Padding="0" BorderThickness="0"
                           Icon="{ui:SymbolIcon Open24}" ToolTip="Abrir Tidy" Click="Open_Click" />
                <StackPanel x:Name="Rail">
                    <ui:Button Tag="0" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon Gauge24}" ToolTip="Resumen" Click="Section_Click" />
                    <ui:Button Tag="1" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon TopSpeed24}" ToolTip="Rendimiento" Click="Section_Click" />
                    <ui:Button Tag="2" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon Broom24}" ToolTip="Limpieza" Click="Section_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,14,18,16">
            <TextBlock x:Name="SectionTitle" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,12" />

            <!-- 0: summary -->
            <StackPanel x:Name="SummaryPanel">
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="Procesador" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Cpu" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="CpuBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Memoria" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Ram" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="RamBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Gráfica" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Gpu" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="GpuBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Temperatura GPU" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Temp" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="TempBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <ui:Button x:Name="BoostBtn" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,11" Margin="0,14,0,0" FontSize="14"
                           Icon="{ui:SymbolIcon Flash24}" Content="Liberar memoria" Click="Boost_Click" />
                <TextBlock x:Name="BoostResult" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="SummaryGame" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <!-- 1: performance -->
            <StackPanel x:Name="PerfPanel" Visibility="Collapsed">
                <TextBlock Text="Plan de energía" Style="{StaticResource Muted}" Margin="2,0,0,6" />
                <UniformGrid x:Name="PlanButtons" Columns="3" />
                <Separator Margin="0,14,0,10" />
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                        <TextBlock Text="RAM automática" FontSize="13" />
                        <TextBlock x:Name="AutoNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoRam" HorizontalAlignment="Right" Click="AutoRam_Click" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                        <TextBlock Text="Modo juego automático" FontSize="13" />
                        <TextBlock x:Name="GameNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="GameAuto" HorizontalAlignment="Right" Click="GameAuto_Click" />
                </Grid>
                <ui:HyperlinkButton Content="Más opciones de rendimiento" Padding="2,6" Margin="0,10,0,0" Click="MorePerf_Click" />
            </StackPanel>

            <!-- 2: cleanup (only shows the size; the list and the confirmation are in the main window) -->
            <StackPanel x:Name="CleanPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Tile}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Se puede liberar" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="CleanSize" Text="Calculando…" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="CleanLast" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,11" Margin="0,14,0,0" FontSize="14"
                           Icon="{ui:SymbolIcon Broom24}" Content="Ver la lista y limpiar…" Click="Clean_Click" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="4,8,4,0"
                           Text="Se abre Tidy con la lista de archivos. No se borra nada sin que lo confirmes." />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
