<ui:FluentWindow x:Class="Tidy.TrayFlyout"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Tidy" Width="430" SizeToContent="Height"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Acrylic" WindowCornerPreference="Round"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sections rail -->
        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel Margin="9,16,9,12">
                <Image DockPanel.Dock="Top" Source="{DynamicResource AppLogo}" Width="24" Height="24" Margin="0,0,0,18" />
                <ui:Button DockPanel.Dock="Bottom" Appearance="Transparent" Width="40" Height="40" Padding="0" BorderThickness="0"
                           Icon="{ui:SymbolIcon Open24}" ToolTip="Abrir Tidy" Click="Open_Click" />
                <StackPanel x:Name="Rail">
                    <ui:Button Tag="0" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon Gauge24}" ToolTip="Resumen" Click="Section_Click" />
                    <ui:Button Tag="1" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon TopSpeed24}" ToolTip="Rendimiento" Click="Section_Click" />
                    <ui:Button Tag="2" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon AppsList24}" ToolTip="Programas" Click="Section_Click" />
                    <ui:Button Tag="3" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon Broom24}" ToolTip="Limpieza" Click="Section_Click" />
                    <ui:Button Tag="4" Width="40" Height="40" Padding="0" Margin="0,0,0,6" BorderThickness="0" Icon="{ui:SymbolIcon ShieldCheckmark24}" ToolTip="Estado" Click="Section_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,14,18,16">
            <TextBlock x:Name="SectionTitle" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,12" />

            <!-- 0: summary -->
            <StackPanel x:Name="SummaryPanel">
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="Procesador" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Cpu" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="CpuBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Memoria" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Ram" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="RamBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Gráfica" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Gpu" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="GpuBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Temperatura GPU" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="Temp" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <ProgressBar x:Name="TempBar" Height="3" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <ui:Button x:Name="BoostBtn" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,11" Margin="0,14,0,0" FontSize="14"
                           Icon="{ui:SymbolIcon Flash24}" Content="Liberar memoria" Click="Boost_Click" />
                <TextBlock x:Name="BoostResult" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="SummaryGame" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <!-- 1: performance -->
            <StackPanel x:Name="PerfPanel" Visibility="Collapsed">
                <TextBlock Text="Plan de energía" Style="{StaticResource Muted}" Margin="2,0,0,6" />
                <UniformGrid x:Name="PlanButtons" Columns="3" />
                <Separator Margin="0,14,0,10" />
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                        <TextBlock Text="RAM automática" FontSize="13" />
                        <TextBlock x:Name="AutoNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoRam" HorizontalAlignment="Right" Click="AutoRam_Click" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                        <TextBlock Text="Modo juego automático" FontSize="13" />
                        <TextBlock x:Name="GameNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="GameAuto" HorizontalAlignment="Right" Click="GameAuto_Click" />
                </Grid>
                <ui:Button x:Name="GameNowBtn" HorizontalAlignment="Stretch" Padding="0,8" Margin="0,12,0,0"
                           Icon="{ui:SymbolIcon Games24}" Click="GameNow_Click" />
                <ui:HyperlinkButton Content="Más opciones de rendimiento" Padding="2,6" Margin="0,8,0,0" Click="MorePerf_Click" />
            </StackPanel>

            <!-- 2: programs: what's using the most right now, and what starts with Windows -->
            <StackPanel x:Name="AppsPanel" Visibility="Collapsed">
                <Grid Margin="2,0,0,6">
                    <TextBlock Text="Lo que más gasta ahora" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ui:Button x:Name="TopRefresh" HorizontalAlignment="Right" Appearance="Transparent" Padding="4" BorderThickness="0"
                               Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Volver a medir" Click="TopRefresh_Click" />
                </Grid>
                <StackPanel x:Name="TopList" />
                <TextBlock x:Name="TopNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" />
                <Separator Margin="0,12,0,10" />
                <TextBlock Text="Arrancan con Windows" Style="{StaticResource Muted}" Margin="2,0,0,6" />
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StartupList" Margin="0,0,6,0" />
                </ScrollViewer>
                <ui:HyperlinkButton Content="Más sobre el inicio de Windows" Padding="2,6" Margin="0,8,0,0" Click="MoreStartup_Click" />
            </StackPanel>

            <!-- 3: cleanup. Nothing is deleted without the exact list on screen and a click on "Borrar definitivamente" -->
            <StackPanel x:Name="CleanPanel" Visibility="Collapsed">
                <StackPanel x:Name="CleanMain">
                    <StackPanel x:Name="Disks" />
                    <Border Style="{StaticResource Tile}" Padding="14,12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Se puede liberar" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="CleanSize" Text="Calculando…" FontSize="22" FontWeight="SemiBold" />
                            <StackPanel x:Name="CleanCats" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <ui:Button x:Name="CleanBtn" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,10" Margin="0,10,0,0" FontSize="14"
                               Icon="{ui:SymbolIcon Broom24}" Content="Revisar y limpiar" IsEnabled="False" Click="CleanReview_Click" />
                    <TextBlock x:Name="CleanResult" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="4,6,4,0" Visibility="Collapsed" />
                    <Grid Margin="2,12,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,90,0">
                            <TextBlock Text="Papelera de reciclaje" FontSize="13" />
                            <TextBlock x:Name="RecycleSize" Style="{StaticResource Muted}" FontSize="11" Text="Calculando…" />
                        </StackPanel>
                        <ui:Button x:Name="RecycleBtn" HorizontalAlignment="Right" Content="Vaciar…" IsEnabled="False" Click="Recycle_Click" />
                    </Grid>
                    <Separator Margin="0,12,0,10" />
                    <Grid Margin="2,0,0,0">
                        <TextBlock Text="Limpieza programada" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScheduleBox" HorizontalAlignment="Right" Width="150" SelectionChanged="Schedule_Changed">
                            <ComboBoxItem Content="Nada" />
                            <ComboBoxItem Content="Avisarme" />
                            <ComboBoxItem Content="Limpiar solo" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="ScheduleNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />
                    <TextBlock x:Name="CleanLast" Style="{StaticResource Muted}" FontSize="11" Margin="2,2,0,0" />
                </StackPanel>

                <StackPanel x:Name="CleanConfirm" Visibility="Collapsed">
                    <TextBlock x:Name="ConfirmTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Se borrarán de forma definitiva estos archivos. Revisa la lista; si algo no te cuadra, cancela." />
                    <TextBlock x:Name="ConfirmRecycle" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="La papelera se vaciará: esos archivos ya no se podrán recuperar." />
                    <ListBox x:Name="ConfirmList" Height="240" Margin="0,10,0,6" Style="{StaticResource FileList}" />
                    <TextBlock x:Name="ConfirmCopy" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <ui:Button Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="ConfirmCancel_Click" />
                        <ui:Button x:Name="ConfirmBtn" Appearance="Danger" Content="Borrar definitivamente" HorizontalAlignment="Stretch" Margin="4,0,0,0" Click="ConfirmClean_Click" />
                    </UniformGrid>
                </StackPanel>
            </StackPanel>

            <!-- 4: status -->
            <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Tile}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="SecIcon" Symbol="ShieldCheckmark24" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Seguridad" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="SecText" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="Revisando…" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="Ver" VerticalAlignment="Center" Click="Security_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Actualizaciones" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdApps" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdDrivers" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdTidy" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ui:Button x:Name="UpdCheckBtn" Content="Comprobar" HorizontalAlignment="Stretch" Click="UpdCheck_Click" ToolTip="Pregunta a winget qué apps tienen versión nueva" />
                            <ui:Button Content="Ver" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="Updates_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Timer24" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Último arranque" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="BootText" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Padding="14,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="History24" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="Lo último que se puede deshacer" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="LastTitle" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="—" />
                            </StackPanel>
                            <ui:Button x:Name="UndoBtn" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed" Click="Undo_Click" />
                        </Grid>
                        <StackPanel x:Name="UndoConfirm" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="UndoText" FontSize="12" TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <ui:Button Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="UndoCancel_Click" />
                                <ui:Button x:Name="UndoYes" Appearance="Primary" HorizontalAlignment="Stretch" Margin="4,0,0,0" Click="UndoYes_Click" />
                            </UniformGrid>
                        </StackPanel>
                        <TextBlock x:Name="UndoResult" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <ui:HyperlinkButton Content="Ver todo el historial" Padding="2,6" Margin="0,6,0,0" Click="History_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
